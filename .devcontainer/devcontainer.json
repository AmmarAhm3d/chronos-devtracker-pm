{
  "name": "Chronos DevTracker - Node 22 + Docker",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:0-22",
  "features": {
    "docker-in-docker": "latest"
  },
  "containerEnv": {
    "NODE_ENV": "development"
  },
  "forwardPorts": [
    5173,
    3001,
    5432
  ],
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteUser": "vscode",
  "postCreateCommand": "bash -lc 'set -e && apt-get update -y && apt-get install -y postgresql-client && npm install || true && if [ -d server ]; then (cd server && npm install) || true; fi && if [ -d client ]; then (cd client && npm install) || true; fi'",
  "postStartCommand": "bash -lc 'set -e && docker-compose -f .devcontainer/docker-compose.yml up -d db || true'",
  "shutdownAction": "stopCompose",
  "extensions": [
    "esbenp.prettier-vscode",
    "dbaeumer.vscode-eslint",
    "Prisma.prisma",
    "ms-azuretools.vscode-docker",
    "ms-playwright.playwright"
  ],
  "settings": {
    "terminal.integrated.profiles.linux": {
      "bash (login)": {
        "path": "/bin/bash",
        "args": [
          "-l"
        ]
      }
    }
  }
}
